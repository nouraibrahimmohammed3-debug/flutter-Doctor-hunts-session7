rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_photos/{uid}/{photo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.isActive == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
    match /doctor_photos/{photo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive == true
        && 'admin' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
  }
}
